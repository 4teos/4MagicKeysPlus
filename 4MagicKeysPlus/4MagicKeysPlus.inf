; Installation inf for the 4MagicKeys+ Driver

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
CatalogFile=4MagicKeysPlus.cat
DriverPackageDisplayName="4MagicKeys+"
DriverPackageType=PlugAndPlay
DriverVer=08/08/2026,2.0.0.27
PnpLockdown=1

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

UKBMnt_Inst.CopyList = 12
Keyboard_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1=%KBDiskName%

[SourceDisksFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll = 1
4MagicKeysPlus.sys = 1,

[Manufacturer]
%Manufacturer% = USBKeyboard,NTamd64

[USBKeyboard.NTamd64]
;Magic Keyboard A1644
%A1644.DevDesc% = Dri_HID_Inst,USB\VID_05AC&PID_0267&MI_01
%A1644.DevDesc% = Dri_BTH_Inst,BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0267
;Magic Keyboard with Numeric Keypad A1843
%A1843.DevDesc% = Dri_HID_Inst,USB\VID_05AC&PID_026C&MI_01
%A1843.DevDesc% = Dri_BTH_Inst,BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&026C

;=====================================================================

[Dri_HID_Inst.NT]
Include = Input.inf
Needs = HID_Inst.NT
Copyfiles = UKBMnt_Inst.CopyList

[Dri_HID_Inst.NT.HW]
AddReg = USBHIDKeyPadDevice.AddReg.NT

[Dri_HID_Inst.NT.Services]
Include = Input.inf
Needs = HID_Inst.NT.Services
AddService = 4MagicKeysPlus,,HIDKbFlt_Service_Inst

[USBHIDKeyPadDevice.AddReg.NT]
HKR,,"LowerFilters",0x00010000,"vhf","4MagicKeysPlus"

[Dri_HID_Inst.NT.Wdf]
KmdfService = 4MagicKeysPlus, keyboard_wdfsect

;=====================================================================

[Dri_BTH_Inst.NT]
Include = hidbth.inf
Needs = HIDBTH_Inst.NT
Copyfiles = UKBMnt_Inst.CopyList

[UKBMnt_Inst.CopyList]
4MagicKeysPlus.sys

[Dri_BTH_Inst.NT.HW.AddReg]
HKR,,"LowerFilters",0x00010000,"vhf","4MagicKeysPlus"

[Dri_BTH_Inst.NT.Services]
Include = hidbth.inf
Needs = HIDBTH_Inst.NT.Services
AddService = 4MagicKeysPlus,,HIDKbFlt_Service_Inst

[HIDKbFlt_Service_Inst]
DisplayName = %HIDKbFlt.SvcDesc%
ServiceType = %SERVICE_KERNEL_DRIVER%
StartType = %SERVICE_DEMAND_START%
ErrorControl = %SERVICE_ERROR_NORMAL%
ServiceBinary = %12%\4MagicKeysPlus.sys
AddReg = HIDKbFlt_Service_AddReg

[HIDKbFlt_Service_AddReg]
HKR,Parameters,FnLock,0x00010003, 0
; Example: HKR,Parameters,KeyMap,0x00000003, F0,4C
HKR,Parameters,KeyMap,0x00000003, 0
; ModMap: modifier bit remapping, pairs of [source_bit, target_bit]
; Example Alt<->Cmd swap: 04,08,08,04,40,80,80,40
HKR,Parameters,ModMap,0x00000003, 0
; SpecialModMap: special keys <-> modifier bit remapping
; Example Fn<->LeftCtrl swap: 01,F1,F1,01
HKR,Parameters,SpecialModMap,0x00000003, 0

[Dri_BTH_Inst.NT.HW]
Include = keyboard.inf
Needs	= HID_Keyboard_Inst.NT.HW
AddReg  = Dri_BTH_Inst.NT.HW.AddReg

[Dri_BTH_Inst.NT.Wdf]
KmdfService = 4MagicKeysPlus, keyboard_wdfsect

;=====================================================================

[keyboard_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

;=====================================================================

[strings]
HID.ClassName = "Human Interface Devices"

SERVICE_KERNEL_DRIVER	= 1
SERVICE_BOOT_START		= 0
SERVICE_SYSTEM_START	= 1
SERVICE_AUTO_START		= 2
SERVICE_DEMAND_START	= 3
SERVICE_ERROR_NORMAL	= 1
SERVICE_ERROR_IGNORE	= 0
REG_EXPAND_SZ			= 0x00020000
REG_DWORD				= 0x00010001
REG_SZ					= 0x00000000

Provider = "4teos"
Manufacturer = "Apple"

A1644.DevDesc = "Apple Magic Keyboard (A1644)"
A1843.DevDesc = "Apple Magic Keyboard with Numeric Keypad (A1843)"
HIDKbFlt.SvcDesc = "4MagicKeys+"
KBDiskName = "4MagicKeys+ Installation"
