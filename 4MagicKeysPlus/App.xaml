<Application x:Class="_4MagicKeysPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_4MagicKeysPlus"
             xmlns:views="clr-namespace:_4MagicKeysPlus.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavToggleButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,3,8,0"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlCheckedBackground}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIconOnlyButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlCheckedBackground}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PanelButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PanelCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                        BorderBrush="{DynamicResource CheckBoxBorder}" Background="{DynamicResource CheckBoxBackground}" VerticalAlignment="Center">
                                    <Path x:Name="Mark" Data="M3,7.5 L6.2,10.7 L12,4.5" Stroke="{DynamicResource CheckBoxMark}" StrokeThickness="2"
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckedBackground}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBorder}"/>
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxDisabledBackground}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxDisabledBorder}"/>
                                    <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource CheckBoxDisabledMark}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BaseToolTipStyle" TargetType="ToolTip">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{DynamicResource TooltipBackground}" BorderBrush="{DynamicResource TooltipBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8">
                                <ContentPresenter TextElement.Foreground="{DynamicResource TooltipForeground}" TextElement.FontWeight="Bold"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TooltipAbove" TargetType="ToolTip" BasedOn="{StaticResource BaseToolTipStyle}">
                <Setter Property="Placement" Value="Custom"/>
                <Setter Property="CustomPopupPlacementCallback" Value="{x:Static views:TooltipPlacement.CenteredAbove}"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="8"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="ToolTip.Opened">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="8" To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TooltipBelow" TargetType="ToolTip" BasedOn="{StaticResource BaseToolTipStyle}">
                <Setter Property="Placement" Value="Custom"/>
                <Setter Property="CustomPopupPlacementCallback" Value="{x:Static views:TooltipPlacement.CenteredBelow}"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-8"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="ToolTip.Opened">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="-8" To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
