<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>_4MagicKeysPlus</RootNamespace>
    <AssemblyName>4MagicKeysPlus</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="4MagicKeysPlusTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\4MagicKeysPlusCore\4MagicKeysPlusCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\HandOpen.png" LogicalName="HandOpen.png" />
    <EmbeddedResource Include="Resources\HandClosed.png" LogicalName="HandClosed.png" />
  </ItemGroup>

</Project>
