<UserControl x:Class="_4MagicKeysPlus.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:_4MagicKeysPlus.Properties"
             xmlns:views="clr-namespace:_4MagicKeysPlus.Views"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="ProblemStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ResultError}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,1,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource TextDisabled}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Good">
                    <Setter Property="Fill" Value="{DynamicResource ResultSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                    <Setter Property="Fill" Value="{DynamicResource ResultWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Bad">
                    <Setter Property="Fill" Value="{DynamicResource ResultError}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlCheckedBackground}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlCheckedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource OptionItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                BorderThickness="1" CornerRadius="6">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,7,32,7" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0" Padding="4" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center">

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static properties:Strings.OptionsAppearance}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static properties:Strings.OptionsTheme}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentStyle}" Content="{x:Static properties:Strings.OptionsThemeSystem}"
                                             IsChecked="{Binding Appearance.ThemeIsSystem}"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" Content="{x:Static properties:Strings.OptionsThemeDark}"
                                             Margin="4,0,0,0" IsChecked="{Binding Appearance.ThemeIsDark}"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" Content="{x:Static properties:Strings.OptionsThemeLight}"
                                             Margin="4,0,0,0" IsChecked="{Binding Appearance.ThemeIsLight}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static properties:Strings.OptionsLanguage}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource OptionComboBoxStyle}" DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding Appearance.Languages}" SelectedItem="{Binding Appearance.SelectedLanguage}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0" Visibility="{Binding Appearance.LanguageRestartRequired, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static views:Glyphs.ResultWarning}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ResultWarning}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource HintStyle}" Margin="0" VerticalAlignment="Center"
                                       Text="{x:Static properties:Strings.OptionsLanguageRestart}"/>
                            <Button Grid.Column="2" Style="{StaticResource PanelButtonStyle}" Margin="12,0,0,0" FontSize="13"
                                    Content="{x:Static properties:Strings.OptionsRestart}" Click="Restart_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource ProblemStyle}" Text="{Binding Appearance.Problem}"
                                   Visibility="{Binding Appearance.HasProblem, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static properties:Strings.OptionsAgent}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static properties:Strings.OptionsAgentStatus}"/>
                                <TextBlock Style="{StaticResource HintStyle}" Text="{x:Static properties:Strings.OptionsAgentHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource StatusDotStyle}" Tag="{Binding Agent.Level}"/>
                                <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding Agent.StatusText}"/>
                                <Button Style="{StaticResource PanelButtonStyle}" Margin="14,0,0,0" FontSize="13"
                                        Content="{x:Static properties:Strings.HotkeyStartAgent}" Click="StartAgent_Click"
                                        Visibility="{Binding Agent.CanStart, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource ProblemStyle}" Text="{Binding Agent.Problem}"
                                   Visibility="{Binding Agent.HasProblem, Converter={StaticResource BoolToVis}}"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static properties:Strings.OptionsAutostart}"/>
                                <TextBlock Style="{StaticResource HintStyle}" Text="{x:Static properties:Strings.OptionsAutostartHint}"/>
                            </StackPanel>
                            <ToggleButton x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          IsChecked="{Binding Agent.AutostartEnabled, Mode=OneWay}" Click="Autostart_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource ProblemStyle}" Text="{Binding Agent.AutostartProblem}"
                                   Visibility="{Binding Agent.HasAutostartProblem, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static properties:Strings.OptionsSystem}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static properties:Strings.OptionsDriver}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDotStyle}" Tag="{Binding Status.DriverLevel}"/>
                                <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding Status.DriverText}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Static properties:Strings.OptionsKeyboard}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDotStyle}" Tag="{Binding Status.KeyboardLevel}"/>
                                <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding Status.KeyboardText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,8,0,0">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       Text="{Binding AppVersion, StringFormat={x:Static properties:Strings.OptionsAppVersion}}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                       Text="{Binding Status.DriverVersion, StringFormat={x:Static properties:Strings.OptionsDriverVersion}}"/>
        </StackPanel>
    </Grid>
</UserControl>
