<UserControl x:Class="_4MagicKeysPlus.Views.HotkeyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:_4MagicKeysPlus.ViewModels"
             xmlns:properties="clr-namespace:_4MagicKeysPlus.Properties"
             xmlns:views="clr-namespace:_4MagicKeysPlus.Views"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddCardStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Rectangle x:Name="Dash" Stroke="{DynamicResource ControlBorder}" StrokeThickness="1" StrokeDashArray="4 3"
                                       RadiusX="8" RadiusY="8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static views:Glyphs.Add}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,2,10,0" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource ControlActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:HotkeyCardViewModel}">
            <Border x:Name="Card" Margin="0,0,0,8" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Transparent" Padding="2,8" Margin="-8,0,8,0" Cursor="{x:Static views:GrabCursors.Open}"
                            Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"
                            PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown" PreviewMouseMove="Grip_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="Grip_PreviewMouseLeftButtonUp">
                        <TextBlock Text="{x:Static views:Glyphs.Grip}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextDisabled}"/>
                    </Border>

                    <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Static views:Glyphs.AppFallback}" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabled}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Path}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"/>

                        <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"
                                 FontSize="14" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                        <Grid Margin="0,6,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Text="{Binding DraftPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathInvalid}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ResultError}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1" Content="{x:Static properties:Strings.HotkeyBrowse}" Margin="8,0,0,0" FontSize="12"
                                    Style="{StaticResource PanelButtonStyle}" Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border x:Name="Chip" MinWidth="170" HorizontalAlignment="Right" Padding="12,6" CornerRadius="6" BorderThickness="1"
                                Focusable="True" FocusVisualStyle="{x:Null}"
                                Background="{DynamicResource ControlCheckedBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                MouseLeftButtonDown="Chip_MouseLeftButtonDown" LostKeyboardFocus="Chip_LostKeyboardFocus">
                            <TextBlock Text="{Binding ChipText}" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <TextBlock Text="{Binding ErrorText}" FontSize="12" Margin="0,6,0,0" MaxWidth="260"
                                   HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ResultError}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding ActionGlyph}" ToolTip="{Binding ActionTooltip}"
                                Style="{StaticResource IconButtonStyle}" Click="Action_Click"/>
                        <Button Content="{x:Static views:Glyphs.Delete}" ToolTip="{x:Static properties:Strings.HotkeyDelete}"
                                Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" Click="Delete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.25"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChipInvalid}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ResultError}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MaxWidth="960" Margin="0,0,0,12" Padding="14,10" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource ResultWarning}"
                Visibility="{Binding AgentStopped, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static views:Glyphs.ResultWarning}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource ResultWarning}"/>
                <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
                <Button Grid.Column="2" Content="{x:Static properties:Strings.HotkeyStartAgent}" Margin="12,0,0,0" FontSize="13"
                        Style="{StaticResource PanelButtonStyle}" Click="StartAgent_Click"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" Margin="0,6,0,0">
                <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}"/>
                <Button Content="{Binding AddText}" Height="{Binding AddHeight}" Style="{StaticResource AddCardStyle}" Click="Add_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Canvas x:Name="DragLayer" Grid.Row="1" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">
            <Border x:Name="Ghost" CornerRadius="8" Opacity="0.85">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6" Color="Black"/>
                </Border.Effect>
            </Border>
        </Canvas>

        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="16,8" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource TooltipBackground}" BorderBrush="{DynamicResource TooltipBorder}"
                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding UndoText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource TooltipForeground}"/>
                <Button Content="{x:Static properties:Strings.HotkeyUndo}" FontSize="13" Style="{StaticResource PanelButtonStyle}" Click="Undo_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
