<Window x:Class="_4MagicKeysPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:_4MagicKeysPlus.Properties"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:_4MagicKeysPlus.ViewModels"
        xmlns:views="clr-namespace:_4MagicKeysPlus.Views"
        mc:Ignorable="d"
        Title="4MagicKeys+"
        Height="800"
        Width="1120"
        MinHeight="420"
        MinWidth="1100"
        MaxWidth="1600"
        WindowStyle="None"
        Background="{DynamicResource WindowBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="4MagicKeys+" VerticalAlignment="Center" Margin="15,0,15,0"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
            <Button Content="—" Width="24" Height="24" Click="MinimizeButton_Click"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <Button Content="✕" Width="24" Height="24" Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding DeviceName}" FontSize="24"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="14,0"/>

        <StackPanel x:Name="rightSide" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Border BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" Background="{DynamicResource BadgeBackground}" Padding="8,4" CornerRadius="4" Margin="24,0"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.BetweenShowDelay="0">
                <Border.ToolTip>
                    <ToolTip Content="{Binding StatusTooltip}" Style="{StaticResource TooltipBelow}"/>
                </Border.ToolTip>

                <StackPanel x:Name="status" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ConnectionGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BatteryUnknown}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatteryState}" Value="Low">
                                        <Setter Property="Foreground" Value="{DynamicResource BatteryLow}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatteryState}" Value="Medium">
                                        <Setter Property="Foreground" Value="{DynamicResource BatteryMedium}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatteryState}" Value="Good">
                                        <Setter Property="Foreground" Value="{DynamicResource BatteryGood}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource FnBadgeOffBackground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FnLockEnabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FnBadgeOnBackground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Fn" FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FnBadgeOffForeground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FnLockEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource FnBadgeOnForeground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel x:Name="navButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0">
                <RadioButton x:Name="NavKeys" Content="{x:Static properties:Strings.NavKeys}" Tag="{x:Static views:Glyphs.KeyboardClassic}"
                             GroupName="Nav" IsChecked="True"
                             Style="{StaticResource NavToggleButtonStyle}" Checked="NavKeys_Checked"/>
                <RadioButton x:Name="NavApps" Content="{x:Static properties:Strings.NavQuickLaunch}" Tag="{x:Static views:Glyphs.Flash}"
                             GroupName="Nav" Margin="4,0,0,0"
                             Style="{StaticResource NavToggleButtonStyle}" Checked="NavApps_Checked"/>
                <RadioButton x:Name="NavOptions" Content="{x:Static properties:Strings.NavSettings}" Tag="{x:Static views:Glyphs.Settings}"
                             GroupName="Nav" Margin="4,0,0,0"
                             Style="{StaticResource NavIconOnlyButtonStyle}" Checked="NavOptions_Checked"/>
            </StackPanel>
        </StackPanel>

        <ContentControl Grid.Row="2" x:Name="MainContent" Margin="24,96,24,24"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
