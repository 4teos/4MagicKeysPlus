<Window x:Class="_4MagicKeysPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:_4MagicKeysPlus.Properties"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:_4MagicKeysPlus.ViewModels"
        xmlns:views="clr-namespace:_4MagicKeysPlus.Views"
        mc:Ignorable="d"
        Title="4MagicKeys+"
        Height="800"
        Width="1120"
        MinHeight="420"
        MinWidth="1100"
        MaxWidth="1600"
        WindowStyle="None"
        Background="{DynamicResource WindowBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- A keyboard in the title bar: a tab with its glyph, and the glyph of the connection (green) while it is connected.
             A keyboard that is not connected is dimmed and cannot be chosen; its name is in the tooltip. -->
        <Style x:Key="KeyboardTabStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="IsEnabled" Value="{Binding IsConnected}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Height="24" Padding="9,0" Margin="0,0,4,0" CornerRadius="4" BorderThickness="1"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowOnDisabled="True">
                            <Border.ToolTip>
                                <ToolTip Content="{Binding Tooltip}" Style="{StaticResource TooltipBelow}"/>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static views:Glyphs.KeyboardClassic}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{Binding ConnectionGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource ResultSuccess}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionGlyph}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlCheckedBackground}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="4MagicKeys+" VerticalAlignment="Center" Margin="15,0,10,0"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" />

            <ListBox x:Name="KeyboardSelector" ItemContainerStyle="{StaticResource KeyboardTabStyle}" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Visibility="{Binding HasSeveralKeyboards, Converter={StaticResource BoolToVis}}"
                     Margin="24,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
            <Button Content="—" Width="24" Height="24" Click="MinimizeButton_Click"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <Button Content="✕" Width="24" Height="24" Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding DeviceName}" FontSize="24"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="14,0"/>

        <StackPanel x:Name="rightSide" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Border BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" Background="{DynamicResource BadgeBackground}" Padding="8,4" CornerRadius="4" Margin="24,0"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.BetweenShowDelay="0">
                <Border.ToolTip>
                    <ToolTip Content="{Binding StatusTooltip}" Style="{StaticResource TooltipBelow}"/>
                </Border.ToolTip>

                <StackPanel x:Name="status" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ConnectionGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BatteryUnknown}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatteryState}" Value="Low">
                                        <Setter Property="Foreground" Value="{DynamicResource BatteryLow}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatteryState}" Value="Medium">
                                        <Setter Property="Foreground" Value="{DynamicResource BatteryMedium}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BatteryState}" Value="Good">
                                        <Setter Property="Foreground" Value="{DynamicResource BatteryGood}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource FnBadgeOffBackground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FnLockEnabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FnBadgeOnBackground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Fn" FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FnBadgeOffForeground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FnLockEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource FnBadgeOnForeground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel x:Name="navButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0">
                <RadioButton x:Name="NavKeys" Content="{x:Static properties:Strings.NavKeys}" Tag="{x:Static views:Glyphs.KeyboardClassic}"
                             GroupName="Nav" IsChecked="True"
                             Style="{StaticResource NavToggleButtonStyle}" Checked="NavKeys_Checked"/>
                <RadioButton x:Name="NavApps" Content="{x:Static properties:Strings.NavQuickLaunch}" Tag="{x:Static views:Glyphs.Flash}"
                             GroupName="Nav" Margin="4,0,0,0"
                             Style="{StaticResource NavToggleButtonStyle}" Checked="NavApps_Checked"/>
                <RadioButton x:Name="NavOptions" Content="{x:Static properties:Strings.NavSettings}" Tag="{x:Static views:Glyphs.Settings}"
                             GroupName="Nav" Margin="4,0,0,0"
                             Style="{StaticResource NavIconOnlyButtonStyle}" Checked="NavOptions_Checked"/>
            </StackPanel>
        </StackPanel>

        <!-- Asks whether a keyboard that has just been connected is one that is already known. -->
        <Border x:Name="LinkBanner" Grid.Row="2" Margin="24,8,24,0" Padding="16,10" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}"
                Visibility="{Binding HasLinkPrompt, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static views:Glyphs.KeyboardClassic}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondary}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LinkPromptText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Problem}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource ResultError}"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <ComboBox Grid.Column="2" Style="{StaticResource OptionComboBoxStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                          DisplayMemberPath="Name" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                          Visibility="{Binding HasSeveralCandidates, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="3" Style="{StaticResource PanelButtonStyle}" Margin="16,0,0,0" FontSize="13" VerticalAlignment="Center"
                        Content="{x:Static properties:Strings.LinkPromptYes}" Click="LinkYes_Click"/>
                <Button Grid.Column="4" Style="{StaticResource PanelButtonStyle}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                        Content="{x:Static properties:Strings.LinkPromptNo}" Click="LinkNo_Click"/>
            </Grid>
        </Border>

        <ContentControl Grid.Row="3" x:Name="MainContent" Margin="24,96,24,24"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
