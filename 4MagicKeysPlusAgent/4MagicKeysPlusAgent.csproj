<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>_4MagicKeysPlusAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>4MagicKeys+ agent</AssemblyTitle>
  </PropertyGroup>

  <!-- The uiAccess manifest only starts from Program Files, so Debug runs from the build folder keep the default one. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SigningCertificate Condition="'$(SigningCertificate)' == ''">$(MSBuildThisFileDirectory)..\4MagicKeysPlusDriver\4MagicKeysPlus.pfx</SigningCertificate>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="4MagicKeysPlusAgentTests" />
    <!-- Moq generates mock proxies for internal types in this dynamically-created assembly. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\4MagicKeysPlusCore\4MagicKeysPlusCore.csproj" />
  </ItemGroup>

  <!-- Signs the apphost in obj, so the copies in bin and in the publish folder are both signed. -->
  <Target Name="SignAgentExe" AfterTargets="_CreateAppHost" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <SignToolCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\*\x64\signtool.exe" />
    </ItemGroup>
    <PropertyGroup>
      <SignToolPath Condition="'$(SignToolPath)' == ''">%(SignToolCandidate.FullPath)</SignToolPath>
    </PropertyGroup>
    <Warning Condition="!Exists('$(SigningCertificate)')" Text="Signing certificate '$(SigningCertificate)' not found. The exe stays unsigned and will not start with uiAccess." />
    <Warning Condition="Exists('$(SigningCertificate)') And '$(SignToolPath)' == ''" Text="signtool.exe not found under the Windows Kits. The exe stays unsigned and will not start with uiAccess." />
    <Exec Condition="Exists('$(SigningCertificate)') And '$(SignToolPath)' != ''" Command="&quot;$(SignToolPath)&quot; sign /f &quot;$(SigningCertificate)&quot; /fd SHA256 &quot;$(AppHostIntermediatePath)&quot;" />
  </Target>

</Project>
