<Project>
  <!-- The one version of the application: the configuration app, the agent and the libraries (and their tests).
       Version makes the SDK take AssemblyVersion, FileVersion and the product version from it.
       The driver has a version of its own, the one in the DriverVer line of its .inf. -->
  <PropertyGroup>
    <MkpAppVersion>2.4.1.16</MkpAppVersion>
    <Version>$(MkpAppVersion)</Version>
    <Company>4teos</Company>
    <Product>4MagicKeys+</Product>
    <Copyright>© 2026 4teos https://github.com/4teos</Copyright>
  </PropertyGroup>
</Project>
